# Copy to .env.local and fill in values from Supabase + Google Cloud Console.
# cp .env.local.example .env.local

# Supabase → Settings → Database → Connection string (Transaction pooler, port 6543)
# Use JDBC format. Example:
# DATABASE_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_USERNAME=postgres.YOUR_PROJECT_REF
# DATABASE_PASSWORD=your-database-password
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Generate: openssl rand -base64 32
JWT_SECRET=

# Google Cloud → Credentials → OAuth 2.0 Client IDs (Android + iOS, comma-separated)
GOOGLE_CLIENT_IDS=
